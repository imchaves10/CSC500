# Ask the user for the number of books purchased
books_purchased = int(input("Enter the number of books purchased this month: "))

# Initialize the points variable
points = 0

# Determine the points based on number of books purchased
if books_purchased == 0:
    points = 0
else:
    if books_purchased == 2:
        points = 5
    else:
        if books_purchased == 4:
            points = 15
        else:
            if books_purchased == 6:
                points = 30
            else:
                if books_purchased >= 8:
                    points = 60

# Display the points awarded
print(f"Points awarded: {points}")
